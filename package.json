    "build:firefox": "tsx scripts/build.ts firefox",
    "build:userscript": "tsx scripts/build.ts userscript",
    "dev": "tsx scripts/dev.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "sass": "^1.104.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
