{
  "name": "uninsta",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Tampermonkey userscript to unsend all your messages in an Instagram DM conversation",
  "author": "Catalin Teodorescu",
  "license": "GPL-3.0-only",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build.ts",
    "build:chrome": "tsx scripts/build.ts chrome",
    "build:firefox": "tsx scripts/build.ts firefox",
    "build:userscript": "tsx scripts/build.ts userscript",
    "dev": "tsx scripts/dev.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.1",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.0": true,
    "sharp@0.34.5": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp"
    ]
  }
}
